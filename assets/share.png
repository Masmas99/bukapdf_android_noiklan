<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0f172a"/>
      <stop offset="100%" style="stop-color:#1e293b"/>
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3b82f6"/>
      <stop offset="100%" style="stop-color:#60a5fa"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#bg)"/>
  <rect x="0" y="0" width="450" height="630" fill="#0f172a"/>
  <rect x="450" y="0" width="750" height="630" fill="url(#bg)"/>
  <circle cx="225" cy="180" r="100" fill="url(#accent)" opacity="0.2"/>
  <rect x="175" y="130" width="100" height="100" rx="20" fill="url(#accent)"/>
  <text x="225" y="190" text-anchor="middle" font-size="52" fill="white" font-family="Arial, sans-serif" font-weight="bold">D</text>
  <text x="225" y="280" text-anchor="middle" font-size="16" fill="#94a3b8" font-family="Arial, sans-serif">DocuView</text>
  <text x="600" y="150" text-anchor="middle" font-size="14" fill="#60a5fa" font-family="Arial, sans-serif" letter-spacing="4">ANDROID PWA</text>
  <text x="600" y="250" text-anchor="middle" font-size="48" fill="#f1f5f9" font-family="Arial, sans-serif" font-weight="bold">DocuView</text>
  <text x="600" y="300" text-anchor="middle" font-size="36" fill="#94a3b8" font-family="Arial, sans-serif">Pembaca PDF Terbaik</text>
  <text x="600" y="350" text-anchor="middle" font-size="22" fill="#cbd5e1" font-family="Arial, sans-serif">Buka PDF secara kilat & offline</text>
  <text x="600" y="390" text-anchor="middle" font-size="18" fill="#64748b" font-family="Arial, sans-serif">100% Lokal • Ringan • Cepat</text>
  <rect x="600" y="440" width="200" height="50" rx="25" fill="url(#accent)"/>
  <text x="700" y="470" text-anchor="middle" font-size="20" fill="white" font-family="Arial, sans-serif" font-weight="bold">INSTALL</text>
  <rect x="100" y="580" width="200" height="3" rx="1.5" fill="#3b82f6" opacity="0.5"/>
</svg>